        <http://ukrainian-movies.org/Company/Trueman%20Production> ;
    ex:Country <http://ukrainian-movies.org/Country/France>,
        <http://ukrainian-movies.org/Country/Poland>,
        <http://ukrainian-movies.org/Country/Ukraine> ;
    ex:Description "П'ять бунтівних підлітків шукають себе в маленьких містечках, що вмирають, на лінії фронту Донбасу. Вони мріють, протестують, борються з сірістю та нудьгою і порушують правила. Поки весь світ навколо них руйнується, шахти закриваються і війна триває, Андрій, Руслан, Ілля, Ліза і Лєра мріють, аби в їхньому житті нарешті щось сталося! Одного разу відомий в Україні шукач пригод і мандрівник Валентин Щербачов запрошує їх взяти участь в унікальній експедиції-терапії й дає їм можливість уперше вирватися на свободу й відкрити нові горизонти в їхньому житті. Пункт призначення – Гімалаї." ;
    ex:Duration 98 ;
    ex:Genre <http://ukrainian-movies.org/Genre/%D0%92%D1%96%D0%B9%D1%81%D1%8C%D0%BA%D0%BE%D0%B2%D0%B8%D0%B9>,
        <http://ukrainian-movies.org/Genre/%D0%94%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D0%B0%D0%BB%D1%8C%D0%BD%D0%B8%D0%B9> ;
    ex:Language <http://ukrainian-movies.org/Language/Russian>,
        <http://ukrainian-movies.org/Language/Ukrainian> ;
    ex:OriginalTitle "Ми не згаснемо" ;
    ex:Popularity "0.9657"^^xsd:float ;
    ex:Poster <https://image.tmdb.org/t/p/w500/8kkKnU0Dhb1sPnxggjDfiuw8KoV.jpg> ;
    ex:Rating "7.7"^^xsd:float ;
