<http://ukrainian-movies.org/movie/Q117389607> a ex:Movie ;
    rdfs:label "Ми не згаснемо" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/vyECVVJulN3XyjHFW2UZnYoEWvO.jpg> ;
    ex:Company <http://ukrainian-movies.org/Company/ARTE%20GEIE>,
        <http://ukrainian-movies.org/Company/Current%20Time%20TV>,
        <http://ukrainian-movies.org/Company/East%20Roads%20Films>,
