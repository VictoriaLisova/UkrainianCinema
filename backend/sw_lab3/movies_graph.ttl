<http://ukrainian-movies.org/movie/Q19628332> a ex:Movie ;
    rdfs:label "Смертельно живий" ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/1346849>,
        <http://ukrainian-movies.org/person/tmdb/1451606>,
        <http://ukrainian-movies.org/person/tmdb/1451607>,
        <http://ukrainian-movies.org/person/tmdb/1451608>,
