<http://ukrainian-movies.org/movie/Q111914875> a ex:Movie ;
    rdfs:label "Різдвяна історія з Тіною Кароль" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/ydab2Cp85DWxu2MfvVxZkWbxWOh.jpg> ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/1311029>,
        <http://ukrainian-movies.org/person/tmdb/5383961> ;
    ex:CastEntry <http://ukrainian-movies.org/cast/Q111914875_1311029>,
