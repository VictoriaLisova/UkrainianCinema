    ex:Country <http://ukrainian-movies.org/Country/Greece>,
        <http://ukrainian-movies.org/Country/Ukraine>,
        <http://ukrainian-movies.org/Country/United%20Kingdom> ;
    ex:Description "The Land of Forgotten Songs is a collective creative collaboration between The Deep Forest Foundation and indigenous amazon communities. It captures moments of the Kaxinawa Huni Kuin, Awa, Kayapo, Matis, Enawene Nawe and Shipibo, who all live alongside the forest. With an ancient myth as a recurring motif we connecting the past and their present. A transcendental journey into the life, rituals and myths of indigenous communities of the amazon forest." ;
    ex:Duration 93 ;
    ex:Genre <http://ukrainian-movies.org/Genre/%D0%94%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D0%B0%D0%BB%D1%8C%D0%BD%D0%B8%D0%B9> ;
