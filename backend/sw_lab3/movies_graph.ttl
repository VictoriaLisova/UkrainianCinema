<http://ukrainian-movies.org/movie/Q65206966> a ex:Movie ;
    rdfs:label "Сквот32" ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/1337746>,
        <http://ukrainian-movies.org/person/tmdb/2139129>,
        <http://ukrainian-movies.org/person/tmdb/2243082>,
        <http://ukrainian-movies.org/person/tmdb/2243101>,
        <http://ukrainian-movies.org/person/tmdb/2243110>,
        <http://ukrainian-movies.org/person/tmdb/3218149> ;
    ex:CastEntry <http://ukrainian-movies.org/cast/Q65206966_1337746>,
        <http://ukrainian-movies.org/cast/Q65206966_2139129>,
        <http://ukrainian-movies.org/cast/Q65206966_2243082>,
        <http://ukrainian-movies.org/cast/Q65206966_2243101>,
        <http://ukrainian-movies.org/cast/Q65206966_2243110>,
        <http://ukrainian-movies.org/cast/Q65206966_3218149> ;
    ex:Company <http://ukrainian-movies.org/Company/Garnet%20International%20Media%20Group>,
        <http://ukrainian-movies.org/Company/Ukrainian%20State%20Film%20Agency> ;
    ex:Country <http://ukrainian-movies.org/Country/Ukraine> ;
    ex:Description "Сучасна історія Пітера Пена про пошук шляху до дорослого життя та усвідомлення власного стилю та талантів. Ліза працює фотографом у паспортному центрі. Одного разу вона потрапляє до товариства вільних і талановитих мрійників: творців, танцюристів, музикантів, які живуть у Сквоті — напівзруйнованому спустошеному будинку. Вісімдесятирічна Фаїна — єдиний законний мешканець будинку і єдина перешкода для забудовника, який планує зруйнувати увесь квартал, а з ним і Сквот. Лізу причаровує енергія, свобода і творчість товариства. Вони борються за свій спосіб життя, створюють та змінюють навколишній світ. Ліза сама змінюється, вона починає шукати своє місце у світі, розвиває своє бачення та стиль. Завдяки Сквоту Лізу помічають як фотографа, а її світ і можливості розширюються." ;
    ex:Duration 100 ;
    ex:Genre <http://ukrainian-movies.org/Genre/%D0%94%D1%80%D0%B0%D0%BC%D0%B0> ;
    ex:OriginalTitle "Сквот32" ;
    ex:Popularity "1.2124"^^xsd:float ;
    ex:Poster <https://image.tmdb.org/t/p/w500/jyWmSmRzhJFcLuVrsob8DZnyEsk.jpg> ;
