<http://ukrainian-movies.org/movie/Q139573945> a ex:Movie ;
    rdfs:label "АУ" ;
    ex:Company <http://ukrainian-movies.org/Company/For-Post%20International%20Producer%20Center>,
        <http://ukrainian-movies.org/Company/Ministry%20of%20Culture%20of%20Ukraine> ;
    ex:Country <http://ukrainian-movies.org/Country/Italy>,
        <http://ukrainian-movies.org/Country/Ukraine> ;
    ex:Description "Аутизм — не хвороба, а стан, з яким людина народжується. Аутизм це пожиттєва особливість розвитку мозку, яка впливає на комунікацію і відносини з іншими людьми, на сприйняття і розуміння навколишнього світу. Герої фільму — дві українські родини, які виховують дітей з розладом аутичного спектру. У центрі сюжету — дві мами, зі своїми синами (10-ти і 15-ти років). Жінки товаришують, діляться труднощами і радостями, підтримують одна одну, хоча й живуть у різних країнах. Фільм про аутизм адресується не лише спільноті, чиїх родин це торкнулося, а суспільству в цілому. Це запрошення кожному глядачеві до розуміння, толерантності й розширення світогляду." ;
    ex:Duration 64 ;
    ex:Genre <http://ukrainian-movies.org/Genre/%D0%94%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D0%B0%D0%BB%D1%8C%D0%BD%D0%B8%D0%B9> ;
    ex:Language <http://ukrainian-movies.org/Language/Italian>,
        <http://ukrainian-movies.org/Language/Russian>,
        <http://ukrainian-movies.org/Language/Ukrainian> ;
    ex:OriginalTitle "АУ" ;
    ex:Popularity "0.4154"^^xsd:float ;
    ex:Poster <https://image.tmdb.org/t/p/w500/5Ng3BGirr7KpZ9PCJ11XVWBoWn6.jpg> ;
    ex:Rating "0.0"^^xsd:float ;
    ex:ReleaseDate "2020-12-03"^^xsd:date ;
    ex:TMDBId 804387 ;
    ex:TMDBUrl "https://www.themoviedb.org/movie/804387" ;
