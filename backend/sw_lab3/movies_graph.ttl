<http://ukrainian-movies.org/movie/Q117127669> a ex:Movie ;
    rdfs:label "Моя бабуся з Марса" ;
    ex:Company <http://ukrainian-movies.org/Company/Directory%20Films>,
        <http://ukrainian-movies.org/Company/Ukrainian%20State%20Film%20Agency>,
        <http://ukrainian-movies.org/Company/Voka%20Films>,
        <http://ukrainian-movies.org/Company/Volia%20Films> ;
    ex:Country <http://ukrainian-movies.org/Country/Belarus>,
        <http://ukrainian-movies.org/Country/Estonia>,
        <http://ukrainian-movies.org/Country/Ukraine> ;
    ex:Description "Бабуся Зіна жила в Україні, Росії та Білорусі — а після виходу на пенсію переїхала до Криму. Дотепна і сповнена життєвих сил, вона завжди об’єднувала свою велику сім’ю. Та після геополітичних змін в Україні, її відвідини стали для родичів випробуванням: Крим перетворився на «віддалену планету», на зразок Марса. Дорослій людині непросто сприйняти нові реалії — тому вся сім’я, розкидана по різних країнах, почала збиратися, щоб підтримати бабусю й відвідати її у день 80-річчя." ;
    ex:Duration 72 ;
    ex:Genre <http://ukrainian-movies.org/Genre/%D0%94%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D0%B0%D0%BB%D1%8C%D0%BD%D0%B8%D0%B9> ;
    ex:Language <http://ukrainian-movies.org/Language/Russian> ;
    ex:OriginalTitle "Моя бабушка с Марса" ;
    ex:Popularity "1.1252"^^xsd:float ;
    ex:Poster <https://image.tmdb.org/t/p/w500/adxFzSjJs3BuwBxddYi5XydlAGv.jpg> ;
