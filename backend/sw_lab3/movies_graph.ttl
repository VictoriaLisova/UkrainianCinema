<http://ukrainian-movies.org/movie/Q106762854> a ex:Movie ;
    rdfs:label "Де ти, Адаме?" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/6UlFvzQ1yd6mutNMILnDe4coHIS.jpg> ;
    ex:Country <http://ukrainian-movies.org/Country/Greece>,
        <http://ukrainian-movies.org/Country/Ukraine> ;
    ex:Description "Сюжет кінофільму розповідає про життя стародавнього монастиря Дохіар на західному узбережжі гори Афон. Неймовірну красу півострову автор показує крізь призму людського буття, де у безперервній праці та молитві народжується ритміка взаємозв’язку людини і природи. Центральними фігурами фільму стають самі монахи: їх побут, молитви, емоції, а головним втіленням духовного прагнення людини до самовдосконалення – старець монастиря ігумен Григорій." ;
    ex:Duration 80 ;
    ex:Genre <http://ukrainian-movies.org/Genre/%D0%94%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D0%B0%D0%BB%D1%8C%D0%BD%D0%B8%D0%B9>,
        <http://ukrainian-movies.org/Genre/%D0%94%D1%80%D0%B0%D0%BC%D0%B0> ;
    ex:Language <http://ukrainian-movies.org/Language/Greek> ;
    ex:OriginalTitle "Де ти, Адаме?" ;
    ex:Popularity "1.0728"^^xsd:float ;
    ex:Poster <https://image.tmdb.org/t/p/w500/6RgDINI07exZbDzUZ1XcrE5iEaF.jpg> ;
    ex:Rating "9.0"^^xsd:float ;
