<http://ukrainian-movies.org/movie/Q137291956> a ex:Movie ;
    rdfs:label "7 бажань" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/o1ah2Hzd9WbmQBb6h9h63Kq22Bm.jpg> ;
