<http://ukrainian-movies.org/movie/Q109264711> a ex:Movie ;
    rdfs:label "Гуллівер повертається" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/gBzyD14X6jzHmX7FLroOCFfj9GM.jpg> ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/111526>,
        <http://ukrainian-movies.org/person/tmdb/1137368>,
        <http://ukrainian-movies.org/person/tmdb/1214551>,
