<http://ukrainian-movies.org/movie/Q139573782> a ex:Movie ;
    rdfs:label "Вантажівка" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/uoZYn3LDjSzIKUhahS9a6iGmoIi.jpg> ;
