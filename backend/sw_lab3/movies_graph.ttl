    ex:Language <http://ukrainian-movies.org/Language/English>,
        <http://ukrainian-movies.org/Language/Ukrainian> ;
    ex:OriginalTitle "Solistene" ;
    ex:Popularity "1.4671"^^xsd:float ;
    ex:Poster <https://image.tmdb.org/t/p/w500/aRGnsVb7LohF4NMYMkY8rukGgK6.jpg> ;
