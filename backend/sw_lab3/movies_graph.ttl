<http://ukrainian-movies.org/movie/Q139573881> a ex:Movie ;
    rdfs:label "Рози. Фільм-кабаре" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/x4l73XohbQSGVJIYvYSm6vwf2xG.jpg> ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/2042503>,
        <http://ukrainian-movies.org/person/tmdb/2171830> ;
    ex:CastEntry <http://ukrainian-movies.org/cast/Q139573881_2042503>,
