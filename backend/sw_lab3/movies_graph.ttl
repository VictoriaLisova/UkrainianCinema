<http://ukrainian-movies.org/movie/Q25440513> a ex:Movie ;
    rdfs:label "Легенда Карпат" ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/1972582>,
        <http://ukrainian-movies.org/person/tmdb/1972583>,
        <http://ukrainian-movies.org/person/tmdb/1972584>,
        <http://ukrainian-movies.org/person/tmdb/1972585>,
        <http://ukrainian-movies.org/person/tmdb/1972586>,
        <http://ukrainian-movies.org/person/tmdb/1972587>,
        <http://ukrainian-movies.org/person/tmdb/1972588> ;
    ex:CastEntry <http://ukrainian-movies.org/cast/Q25440513_1972582>,
        <http://ukrainian-movies.org/cast/Q25440513_1972583>,
        <http://ukrainian-movies.org/cast/Q25440513_1972584>,
        <http://ukrainian-movies.org/cast/Q25440513_1972585>,
        <http://ukrainian-movies.org/cast/Q25440513_1972586>,
        <http://ukrainian-movies.org/cast/Q25440513_1972587>,
        <http://ukrainian-movies.org/cast/Q25440513_1972588> ;
    ex:Company <http://ukrainian-movies.org/Company/Magnat-Media> ;
    ex:Country <http://ukrainian-movies.org/Country/Ukraine> ;
    ex:Description "Перенесемося в Українські Карпати XVIII століття. Народ, який усе своє життя провів серед цих величних гір, серед дрімучих лісів, терпить дуже багато від польських панів. Ці жорстокі люди готові за будь-який непослух карати на смерть, знищуючи цілі сім'ї та села. Не маючи бажання терпіти таке свавілля, захищати невинних усіма силами готовий уже легендарний лідер руху опришків Олекса Довбуш. Він був героєм, якого за будь-яку ціну хотіла знищити влада. Олекса мав відмінні бойові вміння та дар передбачати майбутнє. Ще коли Довбуш був зовсім маленьким, його мати жорстоко вбили поляки, залишивши хлопця сиротою. Це не зламало Олексу – він досконально вивчив гори, накопичив усю злість і тепер готовий мстити. Довбуш зібрав разом таких же як він сміливих людей, щоб вершити справжнє правосуддя. Так Олекса став легендарним героєм Карпат." ;
    ex:Duration 92 ;
    ex:Genre <http://ukrainian-movies.org/Genre/%D0%86%D1%81%D1%82%D0%BE%D1%80%D0%B8%D1%87%D0%BD%D0%B8%D0%B9>,
        <http://ukrainian-movies.org/Genre/%D0%94%D1%80%D0%B0%D0%BC%D0%B0>,
        <http://ukrainian-movies.org/Genre/%D0%9F%D1%80%D0%B8%D0%B3%D0%BE%D0%B4%D0%B8> ;
    ex:Language <http://ukrainian-movies.org/Language/Ukrainian> ;
    ex:OriginalTitle "Легенда Карпат" ;
    ex:Popularity "1.0375"^^xsd:float ;
    ex:Poster <https://image.tmdb.org/t/p/w500/b9N9Sa5AInvKqbVZXmaUBiq9dHb.jpg> ;
