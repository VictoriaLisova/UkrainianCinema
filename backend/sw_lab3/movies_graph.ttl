<http://ukrainian-movies.org/movie/Q139575507> a ex:Movie ;
    rdfs:label "Рубіж. Грубешівська операція" ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/1972507>,
        <http://ukrainian-movies.org/person/tmdb/2039497>,
        <http://ukrainian-movies.org/person/tmdb/3132075> ;
    ex:CastEntry <http://ukrainian-movies.org/cast/Q139575507_1972507>,
        <http://ukrainian-movies.org/cast/Q139575507_2039497>,
        <http://ukrainian-movies.org/cast/Q139575507_3132075> ;
    ex:Company <http://ukrainian-movies.org/Company/UM%20Group>,
        <http://ukrainian-movies.org/Company/Ukrainian%20State%20Film%20Agency> ;
    ex:Country <http://ukrainian-movies.org/Country/Poland>,
        <http://ukrainian-movies.org/Country/Ukraine> ;
    ex:Description "Фільм-діалог відтворює думки та погляди повстанця УПА та польського партизана АК (Армії Крайової). Ці загартовані боями воїни ведуть запеклу суперечку про історію своїх народів у ХХ столітті і, зокрема, у період з 1939 до 1946 року, коли вони хоробро билися проти окупантів і коли їх катувало радянське НКВД та німецьке СС. У жахливому вирі нескінченних битв на всі фронти УПА та АК, зрештою, зіштовхувалися і між собою. Та після років взаємної озлобленості українці й поляки нарешті усвідомили жахливу зовнішню імперіалістичну загрозу, порозумілися і разом почали боротися з загарбниками. У ніч на 28 травня 1946 року була проведена атака на підконтрольне НКВД місто Грубешів – одна з найбільших військових операцій, які УПА здійснила спільно з наступниками АК, польськими повстанцями з ВіН (Воля і Незалежність)." ;
    ex:Duration 52 ;
    ex:Genre <http://ukrainian-movies.org/Genre/%D0%86%D1%81%D1%82%D0%BE%D1%80%D0%B8%D1%87%D0%BD%D0%B8%D0%B9>,
        <http://ukrainian-movies.org/Genre/%D0%92%D1%96%D0%B9%D1%81%D1%8C%D0%BA%D0%BE%D0%B2%D0%B8%D0%B9>,
        <http://ukrainian-movies.org/Genre/%D0%94%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D0%B0%D0%BB%D1%8C%D0%BD%D0%B8%D0%B9>,
        <http://ukrainian-movies.org/Genre/%D0%94%D1%80%D0%B0%D0%BC%D0%B0> ;
    ex:Language <http://ukrainian-movies.org/Language/Polish>,
        <http://ukrainian-movies.org/Language/Ukrainian> ;
