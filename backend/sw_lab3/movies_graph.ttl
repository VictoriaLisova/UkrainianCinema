<http://ukrainian-movies.org/movie/Q137399720> a ex:Movie ;
    rdfs:label "Українка" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/uusPKw1juWNatZ4tgZmtW7lAT3j.jpg> ;
