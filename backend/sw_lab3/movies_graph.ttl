<http://ukrainian-movies.org/movie/Q139573774> a ex:Movie ;
    rdfs:label "Потяг до життя" ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/114>,
        <http://ukrainian-movies.org/person/tmdb/1212346>,
        <http://ukrainian-movies.org/person/tmdb/139459>,
        <http://ukrainian-movies.org/person/tmdb/2202002> ;
    ex:CastEntry <http://ukrainian-movies.org/cast/Q139573774_114>,
        <http://ukrainian-movies.org/cast/Q139573774_1212346>,
        <http://ukrainian-movies.org/cast/Q139573774_139459>,
        <http://ukrainian-movies.org/cast/Q139573774_2202002> ;
    ex:Company <http://ukrainian-movies.org/Company/Kalyna%20Film%20Company> ;
    ex:Country <http://ukrainian-movies.org/Country/Ukraine> ;
    ex:Description "“Потяг до життя” – документальний фільм про реальні історії простих залізничників, які з перших днів повномасштабного вторгнення рятували життя мільйонів українців, іноді – ціною власного. Під обстрілами вони робили штучне сходження вагонів, щоб не дати ворогу взяти в облогу столицю України, здійснювали операцію з відвернення техногенної катастрофи, продовжували керувати рухом поїздів у той час, коли шибки на станціях прошивались ворожими кулями... У фільмі своїми враженнями від українських залізничників діляться екс-прем’єр-міністр Великої Британії Борис Джонсон, голлівудський актор і посол доброї волі Юнісеф Орландо Блум, відомий футболіст та амбасадор United24 Андрій Шевченко. «Потяг до життя» - це  історія боротьби, відданості та героїзму українських залізничників, якої світ ще не бачив." ;
    ex:Duration 90 ;
    ex:Genre <http://ukrainian-movies.org/Genre/%D0%94%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D0%B0%D0%BB%D1%8C%D0%BD%D0%B8%D0%B9> ;
    ex:Language <http://ukrainian-movies.org/Language/English>,
        <http://ukrainian-movies.org/Language/Ukrainian> ;
    ex:OriginalTitle "Потяг до життя" ;
    ex:Popularity "1.189"^^xsd:float ;
