    rdfs:label "Вєаюфром" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/7LKMkQ7sHZxdDGQAFWiC32WmSfx.jpg> ;
    ex:Country <http://ukrainian-movies.org/Country/Ukraine> ;
    ex:Description "Zhenya is 45 years old, he lives in Ukraine, and works as a street cleaner. His mother lives in the US and got him a green card. To maintain it, he has to travel to America every year. Zhenya is looking for a woman and wants to get married. He records his life on video. This movie explores the reality of selfies by using two cameras: one belongs to the protagonist, the other is operated by the director. As a result, the two realities merge in one film." ;
    ex:Duration 71 ;
    ex:Genre <http://ukrainian-movies.org/Genre/%D0%94%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D0%B0%D0%BB%D1%8C%D0%BD%D0%B8%D0%B9> ;
