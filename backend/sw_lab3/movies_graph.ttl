<http://ukrainian-movies.org/movie/Q25432544> a ex:Movie ;
    rdfs:label "Captum (лат. Полон)" ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/1205301>,
        <http://ukrainian-movies.org/person/tmdb/1882717>,
        <http://ukrainian-movies.org/person/tmdb/2274924>,
        <http://ukrainian-movies.org/person/tmdb/2297404>,
        <http://ukrainian-movies.org/person/tmdb/706271> ;
