<http://ukrainian-movies.org/movie/Q139573856> a ex:Movie ;
    rdfs:label "Кілометр" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/ywKr3P5NjSshjLtWeJzyUHseGrg.jpg> ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/2139089>,
        <http://ukrainian-movies.org/person/tmdb/2584958>,
