    ex:TMDBUrl "https://www.themoviedb.org/movie/646517" ;
    ex:VoteCount 1 ;
    ex:WikidataId "Q112679159" ;
    ex:WikidataURI "http://www.wikidata.org/entity/Q112679159" .

