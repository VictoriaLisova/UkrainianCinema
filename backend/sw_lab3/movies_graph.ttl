<http://ukrainian-movies.org/movie/Q12105982> a ex:Movie ;
    rdfs:label "Засипле сніг дороги…" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/ay3sziQgtkv7k3BO4RrjKQyuozj.jpg> ;
    ex:Company <http://ukrainian-movies.org/Company/Ministry%20of%20Culture%20of%20Ukraine>,
        <http://ukrainian-movies.org/Company/Ukranimafilm> ;
    ex:Country <http://ukrainian-movies.org/Country/Ukraine> ;
    ex:Description "Одного зимового вечора літній чоловік, попихкуючи люлькою біля каміну, пригадує найбільш зворушливі моменти свого життя. В його пам’яті постають і зникають, немов сліди на снігу, спогади про безтурботне дитинство, юність, яка припала на роки війни, сумні втрати і переможні салюти, кохання і теплі сімейні прогулянки. Компанію йому складає лише вірний пес — один із героїв і співучасників його давніх вражень." ;
    ex:Duration 8 ;
    ex:Genre <http://ukrainian-movies.org/Genre/%D0%94%D1%80%D0%B0%D0%BC%D0%B0>,
        <http://ukrainian-movies.org/Genre/%D0%9C%D1%83%D0%BB%D1%8C%D1%82%D1%84%D1%96%D0%BB%D1%8C%D0%BC> ;
    ex:Language <http://ukrainian-movies.org/Language/No%20Language> ;
    ex:OriginalTitle "Засипле сніг дороги…" ;
    ex:Popularity "0.7274"^^xsd:float ;
    ex:Poster <https://image.tmdb.org/t/p/w500/jZRFwgLiBLkvLKeZkKe3VkxvFdy.jpg> ;
