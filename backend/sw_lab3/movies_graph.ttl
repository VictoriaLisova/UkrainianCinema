<http://ukrainian-movies.org/movie/Q25438080> a ex:Movie ;
    rdfs:label "Рівень Чорного" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/yablGZgRLR3LT7k0rKy5biShoAi.jpg> ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/1336832>,
        <http://ukrainian-movies.org/person/tmdb/1886434>,
        <http://ukrainian-movies.org/person/tmdb/2239575> ;
    ex:CastEntry <http://ukrainian-movies.org/cast/Q25438080_1336832>,
