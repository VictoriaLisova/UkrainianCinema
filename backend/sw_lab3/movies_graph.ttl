<http://ukrainian-movies.org/movie/Q107030610> a ex:Movie ;
    rdfs:label "Мати Апостолів" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/uDvCycO7foyMMkmgMS1iZt4bWiY.jpg> ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/125958>,
        <http://ukrainian-movies.org/person/tmdb/1619845>,
        <http://ukrainian-movies.org/person/tmdb/2403663>,
        <http://ukrainian-movies.org/person/tmdb/2506000> ;
    ex:CastEntry <http://ukrainian-movies.org/cast/Q107030610_125958>,
