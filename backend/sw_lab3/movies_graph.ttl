<http://ukrainian-movies.org/movie/Q24705028> a ex:Movie ;
    rdfs:label "Маріуполіс" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/43UyAdAe4shEMeHk2CmTrqjUPP8.jpg> ;
    ex:Company <http://ukrainian-movies.org/Company/435%20Films>,
        <http://ukrainian-movies.org/Company/Extimacy%20Films>,
        <http://ukrainian-movies.org/Company/LRT>,
