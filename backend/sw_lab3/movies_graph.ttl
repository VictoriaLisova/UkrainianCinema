<http://ukrainian-movies.org/movie/Q139575604> a ex:Movie ;
    rdfs:label "У пошуках Сковороди" ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/3239332>,
        <http://ukrainian-movies.org/person/tmdb/3968093>,
        <http://ukrainian-movies.org/person/tmdb/3968094>,
