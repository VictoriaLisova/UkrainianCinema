<http://ukrainian-movies.org/movie/Q139575589> a ex:Movie ;
    rdfs:label "Казка про Коника" ;
    ex:Company <http://ukrainian-movies.org/Company/Docutoloka>,
        <http://ukrainian-movies.org/Company/Estonian%20Film%20Institute>,
