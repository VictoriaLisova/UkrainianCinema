<http://ukrainian-movies.org/movie/Q4312327> a ex:Movie ;
    rdfs:label "Назви своє ім’я" ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/1668832>,
        <http://ukrainian-movies.org/person/tmdb/1668833>,
        <http://ukrainian-movies.org/person/tmdb/1668834> ;
    ex:CastEntry <http://ukrainian-movies.org/cast/Q4312327_1668832>,
        <http://ukrainian-movies.org/cast/Q4312327_1668833>,
        <http://ukrainian-movies.org/cast/Q4312327_1668834> ;
    ex:Company <http://ukrainian-movies.org/Company/Plus%20Films>,
        <http://ukrainian-movies.org/Company/USC%20Shoah%20Foundation> ;
    ex:Country <http://ukrainian-movies.org/Country/Ukraine>,
        <http://ukrainian-movies.org/Country/United%20States%20of%20America> ;
    ex:Description "У фільмі люди, які вижили в 1941—1942 роках, розповідають в інтерв’ю, як їм вдалося врятуватися від неминучої загибелі.  Одна з героїнь фільму тернополянка Ірина Максимів, якій у часи тих подій було 11 років, розповідала, як її сім’я допомагала вижити євреям. Під час війни її батьки дев’ять місяців переховували в погребі власного будинку на території німецького генштабу 16 євреїв. За це їх визнали праведниками народів світу. Спогади Ірини Максимів режисери записали в 1994 році в Тернополі. У розмові з нею Стівен Спілберґ зізнався, що дуже вражений благородністю її сім’ї." ;
    ex:Duration 92 ;
    ex:Genre <http://ukrainian-movies.org/Genre/%D0%94%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D0%B0%D0%BB%D1%8C%D0%BD%D0%B8%D0%B9>,
        <http://ukrainian-movies.org/Genre/%D0%94%D1%80%D0%B0%D0%BC%D0%B0> ;
    ex:Language <http://ukrainian-movies.org/Language/Russian>,
        <http://ukrainian-movies.org/Language/Ukrainian> ;
    ex:OriginalTitle "Spell Your Name" ;
    ex:Popularity "2.1263"^^xsd:float ;
    ex:Poster <https://image.tmdb.org/t/p/w500/xktXgi9ynxHYLOkypgbT6pbBV6d.jpg> ;
    ex:Rating "7.6"^^xsd:float ;
