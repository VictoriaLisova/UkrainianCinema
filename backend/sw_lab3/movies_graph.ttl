<http://ukrainian-movies.org/movie/Q121768411> a ex:Movie ;
    rdfs:label "До побачення, синефіли" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/48diTsCPA2vBIXFq8YkRsJYqPMZ.jpg> ;
