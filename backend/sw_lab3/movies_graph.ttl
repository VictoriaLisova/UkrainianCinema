<http://ukrainian-movies.org/movie/Q130296151> a ex:Movie ;
    rdfs:label "Як там Катя?" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/cTrHrEKrK7ge9B5CgYUTyANGgvd.jpg> ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/1916752>,
        <http://ukrainian-movies.org/person/tmdb/1950124>,
        <http://ukrainian-movies.org/person/tmdb/2518718>,
