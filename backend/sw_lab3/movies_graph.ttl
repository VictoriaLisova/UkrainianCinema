<http://ukrainian-movies.org/movie/Q139573725> a ex:Movie ;
    rdfs:label "Мишоловка" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/iV5KGMZuzfzqo0KY8s4jfhLZHEP.jpg> ;
