        <http://ukrainian-movies.org/Language/Ukrainian> ;
    ex:OriginalTitle "Стрічка часу" ;
    ex:Popularity "1.1503"^^xsd:float ;
    ex:Poster <https://image.tmdb.org/t/p/w500/b49YNh0qTTBbxS7IP4sWdypTKoP.jpg> ;
