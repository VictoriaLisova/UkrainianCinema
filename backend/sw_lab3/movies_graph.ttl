<http://ukrainian-movies.org/movie/Q56479557> a ex:Movie ;
    rdfs:label "Секс і нічого особистого" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/9El3fKKhObVaWS4OYpEdkpGGm9a.jpg> ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/1261201>,
