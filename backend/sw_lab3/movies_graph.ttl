<http://ukrainian-movies.org/movie/Q99479107> a ex:Movie ;
    rdfs:label "Вусатий фанк" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/lWhlYU5Szx23MxaEwODnNlu8oWs.jpg> ;
