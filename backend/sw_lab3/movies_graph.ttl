    ex:OriginalTitle "Країна мрій? Країна дій!" ;
    ex:Popularity "1.0592"^^xsd:float ;
    ex:Poster <https://image.tmdb.org/t/p/w500/y7gQ5V3JqrWINh5iXZL9A2QnueH.jpg> ;
