<http://ukrainian-movies.org/movie/Q20091128> a ex:Movie ;
    rdfs:label "Переможець" ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/1257262>,
        <http://ukrainian-movies.org/person/tmdb/2232201>,
        <http://ukrainian-movies.org/person/tmdb/238693>,
        <http://ukrainian-movies.org/person/tmdb/2501785>,
        <http://ukrainian-movies.org/person/tmdb/933190>,
        <http://ukrainian-movies.org/person/tmdb/97369> ;
    ex:CastEntry <http://ukrainian-movies.org/cast/Q20091128_1257262>,
        <http://ukrainian-movies.org/cast/Q20091128_2232201>,
