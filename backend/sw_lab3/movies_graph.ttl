    rdfs:label "Lara Fabian - Mademoiselle Zhivago" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/7W0PPramOszwmBUNGnHGRpnBKNh.jpg> ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/1336560>,
