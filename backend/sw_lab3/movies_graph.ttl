<http://ukrainian-movies.org/movie/Q65206214> a ex:Movie ;
    rdfs:label "Дух лісу" ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/2346807>,
        <http://ukrainian-movies.org/person/tmdb/5589615> ;
    ex:CastEntry <http://ukrainian-movies.org/cast/Q65206214_2346807>,
        <http://ukrainian-movies.org/cast/Q65206214_5589615> ;
    ex:Company <http://ukrainian-movies.org/Company/Big%20Hand%20Films> ;
    ex:Country <http://ukrainian-movies.org/Country/Ukraine> ;
    ex:Description "The son of a lumberjack, at his father's behest, cuts down his first tree. The annual rings on the cut surface remind him of a fingerprint. Realizing that he has made an irreparable mistake, the boy runs away into the depths of the forest, where he encounters a living tree that transports him to the Spirit of the Forest. This mysterious creature explains to the boy the true essence of the relationship between man and nature and returns him to his family. Now the boy must convince his father and other lumberjacks to abandon the work they have been doing all their lives." ;
    ex:Duration 24 ;
    ex:Genre <http://ukrainian-movies.org/Genre/%D0%A4%D0%B5%D0%BD%D1%82%D0%B5%D0%B7%D1%96> ;
    ex:Language <http://ukrainian-movies.org/Language/Ukrainian> ;
    ex:OriginalTitle "Дух лісу" ;
    ex:Popularity "0.5536"^^xsd:float ;
    ex:Poster <https://image.tmdb.org/t/p/w500/g8MNWBPJKOgcFB6YrqGhMjHDlXW.jpg> ;
    ex:Rating "0.0"^^xsd:float ;
    ex:ReleaseDate "2019-01-01"^^xsd:date ;
    ex:ScreenWriter <http://ukrainian-movies.org/person/tmdb/5589616> ;
