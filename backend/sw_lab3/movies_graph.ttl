<http://ukrainian-movies.org/movie/Q111043036> a ex:Movie ;
    rdfs:label "Будинок зі скалок" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/qNa2UgCl0lJebvBy91ViUte9uXM.jpg> ;
    ex:Company <http://ukrainian-movies.org/Company/Cinephil>,
        <http://ukrainian-movies.org/Company/Donkey%20Hotel>,
        <http://ukrainian-movies.org/Company/Final%20Cut%20for%20Real>,
        <http://ukrainian-movies.org/Company/MDR>,
        <http://ukrainian-movies.org/Company/Ministry%20of%20Culture%20of%20Ukraine>,
