<http://ukrainian-movies.org/movie/Q59454971> a ex:Movie ;
    rdfs:label "Дельта" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/cz4N4LS7D56pB2OvV3bkKcowRLE.jpg> ;
