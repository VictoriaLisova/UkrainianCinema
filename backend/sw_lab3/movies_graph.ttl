<http://ukrainian-movies.org/movie/Q139573785> a ex:Movie ;
    rdfs:label "РІК" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/z1qqPgaWpheOTiCwMLznBzi1oeu.jpg> ;
