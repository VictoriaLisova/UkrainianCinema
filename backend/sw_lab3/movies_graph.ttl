    ex:OriginalTitle "Будинок зі скалок" ;
    ex:Popularity "2.7126"^^xsd:float ;
    ex:Poster <https://image.tmdb.org/t/p/w500/1880L861D56VdGZ55MC4zsi42h6.jpg> ;
