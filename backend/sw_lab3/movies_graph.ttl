<http://ukrainian-movies.org/movie/Q131840192> a ex:Movie ;
    rdfs:label "Стрічка часу" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/zZRJD5mVrpEFGbPcgLMWtqscbS5.jpg> ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/5193955>,
