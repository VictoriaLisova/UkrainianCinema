<http://ukrainian-movies.org/movie/Q61816214> a ex:Movie ;
    rdfs:label "2020. Безлюдна країна" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/oITl6zJp1C2p54MF208sRUdOssk.jpg> ;
