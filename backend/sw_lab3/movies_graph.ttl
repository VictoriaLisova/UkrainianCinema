<http://ukrainian-movies.org/movie/Q135916330> a ex:Movie ;
    rdfs:label "Куба і Аляска" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/3iZwXeZmitP4fvwn3qXmb5ofjbl.jpg> ;
