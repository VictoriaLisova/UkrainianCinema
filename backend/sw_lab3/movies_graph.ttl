<http://ukrainian-movies.org/movie/Q133305430> a ex:Movie ;
    rdfs:label "Реал" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/tvj2Vlb2TJbtCcOx0hvBSIO7I1G.jpg> ;
    ex:Company <http://ukrainian-movies.org/Company/Arthouse%20Traffic>,
        <http://ukrainian-movies.org/Company/Downey%20Ink.>,
        <http://ukrainian-movies.org/Company/Krai%20Kinema>,
