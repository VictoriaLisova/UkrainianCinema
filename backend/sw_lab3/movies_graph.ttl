    ex:Company <http://ukrainian-movies.org/Company/Monolith%20Films>,
        <http://ukrainian-movies.org/Company/Sota%20Cinema%20Group>,
        <http://ukrainian-movies.org/Company/Studio%20Filmowe%20Tor>,
