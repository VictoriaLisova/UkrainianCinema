    rdfs:label "Сафо. Кохання без меж" ;
    ex:Backdrop <https://image.tmdb.org/t/p/w1280/tvWEAZMkN51vMOBHN5FZZuFZTIs.jpg> ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/1052659>,
