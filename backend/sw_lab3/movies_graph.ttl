<http://ukrainian-movies.org/movie/Q12118381> a ex:Movie ;
    rdfs:label "Ломбард" ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/1208576>,
        <http://ukrainian-movies.org/person/tmdb/2232571>,
        <http://ukrainian-movies.org/person/tmdb/224281>,
