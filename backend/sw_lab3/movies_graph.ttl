<http://ukrainian-movies.org/movie/Q139573922> a ex:Movie ;
    rdfs:label "Маніфест 2017" ;
    ex:Cast <http://ukrainian-movies.org/person/tmdb/1385711>,
        <http://ukrainian-movies.org/person/tmdb/1390790> ;
    ex:CastEntry <http://ukrainian-movies.org/cast/Q139573922_1385711>,
